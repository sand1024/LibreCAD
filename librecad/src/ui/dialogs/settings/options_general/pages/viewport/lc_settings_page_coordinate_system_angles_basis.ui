      <item>
       <widget class="QLabel" name="label">
        <property name="text">
         <string>Angles Basis Maker is a an overlay that could be drawn in zero point of the coordinate system and which displays current direction of angles (clockwise or counterclockwise), and location of Base Angle. The Base Angle (also known as the angle 0 direction) is the baseline or starting direction from which all other angles are measured and calculated.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="label_2">
        <property name="text">
