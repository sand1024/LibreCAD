      <item row="0" column="0" colspan="4">
       <widget class="QLabel" name="label2">
        <property name="text">
         <string>Draft Mode is a simplified mode of drawings rendering. It is used mostly for increasing drawing speed and responsiveness of UI. In this mode all texts, hatches and images are rendered as placeholders, and default linewidth is used for all entities.&lt;br&gt; Draft Mode Marker is an overlay that is shown in corners of the drawing area for clear visual indication that Draft Mode is currently enabled.</string>
        </property>
