    <y>0</y>
    <width>732</width>
    <height>647</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="gbArcs">
     <property name="title">
      <string>Arcs Rendering</string>
     </property>
     <layout class="QVBoxLayout" name="layArcs">
      <item>
       <widget class="QLabel" name="label">
        <property name="text">
         <string>Arcs may be rendered by different ways, and the settings below controls that.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rbRenderArcQT">
        <property name="toolTip">
         <string>Standard Rendering

If this method is selected, arcs are drawn using
methods of QT library.  On large zooms, arcs may be
rendered with errors near endpoints.</string>
        </property>
        <property name="text">
         <string>Qt-native drawing method (unexact near endpoints)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rbRenderArcInterpolate">
        <property name="toolTip">
         <string>Arcs By Lines

If selected, archs are drawn using staight line chord segments
interpolation. This eliminates drawing artefacts near to 
endpoints, yet in some cases resulting arcs may be less
smooth, yet without drawing errors near endpoints on large zooms.
</string>
        </property>
        <property name="text">
         <string>Interpolate by line segments</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="gbInterpolateMethod">
        <property name="title">
         <string>Tessellation Method</string>
        </property>
        <layout class="QGridLayout" name="gridLayout">
         <item row="1" column="1">
          <widget class="QDoubleSpinBox" name="sbRenderArcMaxSagitta">
           <property name="toolTip">
            <string>Max Error

Maximum allowable distance (in pixels)
between chord and true arc curve that 
represents maximal interpolation error.</string>
           </property>
           <property name="prefix">
            <string/>
           </property>
           <property name="suffix">
            <string> px</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.050000000000000</double>
           </property>
           <property name="maximum">
            <double>20.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.900000000000000</double>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QDoubleSpinBox" name="sbRenderArcSegmentAngle">
           <property name="toolTip">
            <string>Fixed Segment Angle

Value of fixed central angle (in degrees)
for each interpolation segment.</string>
           </property>
           <property name="suffix">
            <string> °</string>
           </property>
           <property name="minimum">
            <double>1.000000000000000</double>
           </property>
           <property name="maximum">
            <double>30.000000000000000</double>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QRadioButton" name="rbRenderArcMethodSagitta">
           <property name="toolTip">
            <string>Maximal Error

If selected, subdivide arcs adaptively so the angle
of the line interpolation segment is calculated to 
ensure that resulting sagitta (height of arc segment) that 
represents a maximal distance between interpolated and 
true arc is less than specified. </string>
           </property>
           <property name="text">
            <string>Determine segments by max sagitta:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="0">
          <widget class="QRadioButton" name="rbRenderArcMethodFixed">
           <property name="toolTip">
            <string>Fixed Segments Amount

If selected, subdivide arcs by a fixed angular segment increments
with specified fixed angle of line interpolation segment. 
Smaller angle deliver more smooth arc yet is slower..</string>
           </property>
           <property name="text">
            <string>Use fixed segment angle value (°):</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <spacer name="horizontalSpacer">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>0</width>
             <height>0</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbRenderCirclesAsArcs">
        <property name="toolTip">
         <string>Render Cricles

If selected, the same rendering settings
will be applied also to circles rendering.</string>
        </property>
        <property name="text">
         <string>Render circles in the same way as arcs.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
