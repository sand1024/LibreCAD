      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QCheckBox" name="cbHideRelativeZero">
        <property name="toolTip">
         <string>Relative Point Marker Visibility

If checked, relative zero crosshair marker will not be drawn.
Otherwise, one will be visible. Visibility of the marker does not
affect relative zero related operations. </string>
        </property>
        <property name="text">
         <string>Hide relative zero</string>
