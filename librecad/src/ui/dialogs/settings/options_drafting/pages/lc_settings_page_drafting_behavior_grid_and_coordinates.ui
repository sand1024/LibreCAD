    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Grid Visibility</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_3">
      <item row="2" column="0">
       <widget class="QCheckBox" name="cbDrawMetaGrid">
        <property name="toolTip">
         <string>Meta-Grid Visibility

If checked, metagrid will be drawn as part of grid drawing.</string>
        </property>
        <property name="text">
         <string>Draw meta-grid</string>
        </property>
       </widget>
      </item>
      <item row="0" column="0">
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>The Grid is a visual pattern of lines or dots that acts as a digital sheet of graph paper. It provides draftspersons with a sense of scale, distance, and alignment directly in the drawing area. When paired with Grid Snap, it locks the cursor to precise increments for fast, accurate drafting.It it possible to control visibility of both grid and metagrid indepenently.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="cbDrawGrid">
        <property name="toolTip">
         <string>Grid Visibility

If checked, grid wil be drawn</string>
        </property>
        <property name="text">
         <string>Draw grid</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QCheckBox" name="cbDrawVerticalForIsoTop">
        <property name="toolTip">
         <string>Isometric Top Grid

If unchecked, vertical line will not be drawn for &quot;Top&quot; isometric view</string>
        </property>
        <property name="text">
         <string>Draw vertical lines for isometric top view</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gbGridBehavior">
     <property name="title">
      <string>Grid Behavior</string>
     </property>
     <layout class="QGridLayout" name="gridLayout">
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="cbUnitlessGrid">
        <property name="toolTip">
         <string>Unitless Grid

If checked, grid will not be adjusted to current units of drawing
Interpret grid units as generic unitless values.</string>
        </property>
        <property name="text">
         <string>Unitless grid</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QCheckBox" name="cbScaleGrid">
        <property name="toolTip">
         <string>Grid Auto Scale

If checked, the grid will be scalled automatically</string>
        </property>
        <property name="text">
         <string>Auto-scale grid on zoom</string>
        </property>
       </widget>
      </item>
      <item row="2" column="2">
       <spacer name="horizontalSpacer">
        <property name="orientation">
