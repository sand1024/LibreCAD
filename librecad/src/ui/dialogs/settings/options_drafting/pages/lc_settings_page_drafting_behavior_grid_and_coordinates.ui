        </property>
        <property name="text">
         <string>Show UCS zero marker</string>
        </property>
       </widget>
      </item>
      <item row="0" column="0" colspan="3">
       <widget class="QLabel" name="label_5">
        <property name="text">
         <string>Specify visibility of coordinate system-related markers, such as one usd for Relative Zero, coordinate system origins and angles basis.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
