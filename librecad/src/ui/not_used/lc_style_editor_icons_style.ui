     <layout class="QGridLayout" name="gridLayout_5">
      <property name="spacing">
       <number>10</number>
      </property>
      <item row="0" column="0" colspan="4">
       <widget class="QLabel" name="lblInstructions">
        <property name="text">
         <string>Enable &lt;b&gt;'Link to Theme Palette'&lt;/b&gt; to automatically synchronize icon strokes, highlights, and backgrounds with your active UI theme. Disable it to manually assign custom, static colors.</string>
        </property>
